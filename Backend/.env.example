PORT=5000
MONGO_URI=mongodb://localhost:27017/stocksense
JWT_SECRET=your_strong_jwt_secret_here

# ── CORS ───────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: set to your Vercel URL (comma-separate multiple origins if needed)
# e.g. FRONTEND_URL=https://stocksense.vercel.app,https://stocksense-git-main-xyz.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Email (EmailJS) ─────────────────────────────────────────────────────────
# Register at emailjs.com and connect a mail client
EMAILJS_SERVICE_ID=service_your_service_id
EMAILJS_TEMPLATE_ID=template_your_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
STORE_NAME=StockSense Store
