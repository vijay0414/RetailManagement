PORT=5000
MONGO_URI=mongodb://localhost:27017/stocksense
JWT_SECRET=your_strong_jwt_secret_here

# ── CORS ───────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: set to your Vercel URL (comma-separate multiple origins if needed)
# e.g. FRONTEND_URL=https://stocksense.vercel.app,https://stocksense-git-main-xyz.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Email (Gmail App Password) ─────────────────────────────────────────────
# Generate an App Password at: https://myaccount.google.com/apppasswords
# (Gmail 2-Step Verification must be ON. Use the App Password, NOT your Gmail password)
# SMTP_PORT: 587 (default STARTTLS). If your host blocks 587, set SMTP_PORT=465 (SSL).
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
SMTP_PORT=465
STORE_NAME=StockSense Store
